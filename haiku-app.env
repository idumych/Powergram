# haiku-app.env — what the beos-app-platforms release tools need to know about this app.
# Shell syntax: sourced by packaging/*.sh, the CI workflow and the
# release scripts (check-artifact.sh, release-gate.sh). Keep values quoted; no spaces around '='.

# ── Identity ──
APP_NAME="Powergram"
APP_CMD="powergram"
APP_SIG="application/x-vnd.powergram"
RDEF="src/app/Powergram.rdef"

# Haiku only for this preview: the Linux (Cosmoe) port isn't done yet; the
# release notes and README say so.
PLATFORMS="haiku"
APP_PATH="apps/Powergram"
DESKBAR_NAME="Powergram"

# ── Version (also in the .rdef app_version) ──
VERSION="0.2.2"
REVISION="1"

# ── Package metadata ──
SUMMARY="A Telegram client for Haiku, after Paper Plane"
DESCRIPTION_FILE="packaging/description.txt"
HOMEPAGE="https://github.com/idumych/Powergram"
GITHUB_REPO="idumych/Powergram"
LICENSE_NAME="GNU GPL v3"
COPYRIGHT="2026 the Powergram contributors"
PACKAGER="idumych <19998719+idumych@users.noreply.github.com>"

# Extra runtime dependencies beyond the Haiku API itself. TDLib is linked
# in statically; noto_emoji draws emoji (Haiku ships no emoji font); libopus
# and libogg record voice messages (installed with Haiku's media add-ons).
HPKG_REQUIRES_EXTRA="lib:libssl lib:libcrypto lib:libz lib:libopus lib:libogg noto_emoji"
# The app was released as Paper Plane (0.1.0, package "paperplane").
HPKG_REPLACES="paperplane"
DESKTOP_CATEGORIES="Network;InstantMessaging;"
APPIMAGE_MUST_BUNDLE=""
APPIMAGE_FONTS_EXTRA=""
APPIMAGE_TRANSLATORS="JPEG PNG WebP GIF"
COSMOE_REPO=""
COSMOE_TAG=""
SMOKE_ARGS=""
SMOKE_WINDOW=""
SMOKE_PROCESS=""
APPIMAGE_APT_EXTRA=""

# ── Build ──
# tdlib (static, build time only), openssl3_devel, zlib_devel, opus_devel,
# libogg_devel. On a VM
# whose /boot is full, extract tdlib to /Data and pass its paths in
# CXXFLAGS/LDFLAGS (release/test-plan.md, "Building on haiku-b6-test").
HPKG_BUILD_DEPS="tdlib openssl3_devel zlib_devel opus_devel libogg_devel"
TEST_CMD="make test"
# TdClient.cpp needs TDLib's headers, which the type check doesn't have; it
# is checked by the Haiku build instead.
TYPECHECK_SRCS="src/app/[!T]*.cpp"
TYPECHECK_INCLUDES="src/app src/core"
TYPECHECK_CXXFLAGS="-D__HAIKU__ -std=c++17"

# ── Feature test (the app-specific part of release/test-plan.md) ──
# A network client whose peer is Telegram itself: the checks need no account
# and no real API key. A fresh start shows the API key page; a made-up key
# reaches Telegram, which rejects it, and the app shows that. The browser
# opens the page where keys are made, and a settings folder from the app's
# earlier name (Paper Plane) moves over.
FEATURE_CHECKS="api-key-screen browser-opens settings-moved telegram-reachable"
EVIDENCE_1="{p}-screen.txt|Telegram API key"
EVIDENCE_2="{p}-reachable.txt|does not accept this API"
EVIDENCE_3="{p}-browser.txt|my.telegram.org/apps"
EVIDENCE_4="{p}-moved.txt|marker"
